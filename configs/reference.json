{
  "local_files_only": true,
  "batch_size": 8,
  "eval_batch_size": 8,
  "num_workers": 0,
  "pin_memory": true,
  "seed": 42,
  "mutation_window_radius": 8,
  "complex_temper_alpha": 0.5,
  "same_complex_pairs_per_batch": 2,
  "prefer_contrastive_diversity": true,
  "require_sequence_change": true,
  "allow_sequence_truncation": false,
  "long_sequence_strategy": "sliding_window",
  "contrastive_min_seq_id": 0.9,
  "contrastive_min_cov": 0.8,
  "require_safe_contrastive_mask": true,
  "target_standardize": true,
  "training_stage": "selection",
  "model_dim": 256,
  "hidden_size": 256,
  "num_heads": 4,
  "interaction_heads": 4,
  "num_latent_tokens": 16,
  "dropout": 0.1,
  "freeze_backbone": true,
  "use_mamba_branch": true,
  "mamba_layers": 1,
  "mamba_d_state": 16,
  "mamba_d_conv": 4,
  "mamba_expand": 2,
  "mamba_dropout": 0.1,
  "allow_mamba_fallback": false,
  "esm_chunk_overlap": 128,
  "loss": "mse",
  "use_pairwise_loss": true,
  "pairwise_weight": 0.05,
  "pairwise_beta": 1.0,
  "use_contrastive": true,
  "proj_dim": 128,
  "contrastive_temperature": 0.1,
  "cl1_weight": 0.005,
  "cl2_weight": 0.0025,
  "cl_warmup_start_epoch": 5,
  "cl_warmup_end_epoch": 15,
  "unchanged_weight": 0.0,
  "ag_consistency_inner_weight": 0.0,
  "lr": 4e-05,
  "weight_decay": 0.0003,
  "adam_beta1": 0.9,
  "adam_beta2": 0.999,
  "adam_eps": 1e-08,
  "warmup_ratio": 0.08,
  "min_lr": 1e-06,
  "use_lr_scheduler": true,
  "direction_epsilon": 0.0,
  "strict_reviewer_mode": true,
  "log_detailed_contrastive_stats": true,
  "selection": {
    "horizon_epochs": 40,
    "selection_start_epoch": 16,
    "min_refit_epochs": 32,
    "max_refit_epochs": 40,
    "val_rmse_safe_fraction": 0.03,
    "min_val_pred_std_ratio": 0.3
  }
}
